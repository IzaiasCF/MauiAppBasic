<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage
    x:Class="MauiAppBasic.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    SelectedTabColor="White"
    UnselectedTabColor="Gray"
    BarBackground="blue">

    <ContentPage
        Title="Vídeo"
        IconImageSource="dotnet_bot.png">

        <ScrollView>

            <VerticalStackLayout Margin="15" BackgroundColor="Gray">

                <Label Text="Vídeo"
                   TextColor="White"
                   FontSize="20"
                   HorizontalOptions="Center"
                   Padding="15" />

                <WebView
                    x:Name="ICFvideos"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Scale="0.50"
                    WidthRequest="600"
                    HeightRequest="350" />

            </VerticalStackLayout>

        </ScrollView>

    </ContentPage>

    <ContentPage
        Title="Navegação"
        IconImageSource="dotnet_bot.png">

        <ScrollView>

            <VerticalStackLayout Margin="15" BackgroundColor="Gray">

                <Label Text="Página de Navegação"
                   TextColor="White"
                   FontSize="20"
                   HorizontalOptions="Center"
                   Padding="15" />

            </VerticalStackLayout>

        </ScrollView>

    </ContentPage>

</TabbedPage>
