<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage
    x:Class="MauiAppBasic.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    SelectedTabColor="Black"
    UnselectedTabColor="LightGray"
    BarBackground="Magenta">

    <ContentPage
        Title="Grid"
        IconImageSource="dotnet_bot.png">

        <ScrollView>

            <VerticalStackLayout Margin="15">

                <Label Text="Página de Grid"
                   TextColor="White"
                   FontSize="20"
                   HorizontalOptions="Center"
                   Padding="15"
                   BackgroundColor="Blue" />

             </VerticalStackLayout>

        </ScrollView>

    </ContentPage>

    <ContentPage
        Title="Navegação"
        IconImageSource="dotnet_bot.png">

        <ScrollView>

            <VerticalStackLayout Margin="15">

                <Label Text="Página de Navegação"
                   TextColor="White"
                   FontSize="20"
                   HorizontalOptions="Center"
                   Padding="15"
                   BackgroundColor="Blue" />

            </VerticalStackLayout>

        </ScrollView>

    </ContentPage>

</TabbedPage>
